COURTHOUSE_HOST=127.0.0.1
COURTHOUSE_PORT=8050
COURTHOUSE_PRELOAD_AGENTS=1
COURTHOUSE_MAX_LOADED=4
COURTHOUSE_N_CTX=8192
COURTHOUSE_GPU_LAYERS=0
COURTHOUSE_MAX_MODEL_BYTES=8589934592
# COURTHOUSE_AGENTS_CONFIG=/absolute/path/to/config/agent_models.json
